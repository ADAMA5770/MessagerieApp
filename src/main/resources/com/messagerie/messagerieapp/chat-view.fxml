<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.layout.StackPane?>

<HBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.messagerie.messagerieapp.ui.ChatController"
      prefWidth="1200" prefHeight="700">
    <VBox prefWidth="68" prefHeight="700" style="-fx-background-color: #3F0E40;">
        <StackPane prefWidth="48" prefHeight="48">
            <Circle radius="24" fill="#ECB22E"/>
            <Label text="M" style="-fx-text-fill: #3F0E40; -fx-font-size: 18; -fx-font-weight: bold;"/>
        </StackPane>
        <StackPane prefWidth="44" prefHeight="44">
            <Circle radius="22" fill="#1264A3"/>
            <Label fx:id="avatarLabel" text="?" style="-fx-text-fill: white; -fx-font-size: 15; -fx-font-weight: bold;"/>
        </StackPane>
    </VBox>
    <VBox prefWidth="260" prefHeight="700" style="-fx-background-color: #3F0E40;">
        <Label text="Messagerie App" style="-fx-text-fill: white; -fx-font-size: 15; -fx-font-weight: bold; -fx-padding: 16;"/>
        <Label fx:id="currentUserLabel" text="vous" style="-fx-text-fill: white; -fx-font-size: 12; -fx-padding: 4;"/>
        <Button text="Quitter" onAction="#handleLogout" style="-fx-background-color: #5a1a5b; -fx-text-fill: red; -fx-font-size: 11; -fx-background-radius: 4; -fx-cursor: hand; -fx-border-width: 0; -fx-padding: 6;"/>
        <Label text="Messages directs" style="-fx-text-fill: white; -fx-font-size: 12; -fx-font-weight: bold; -fx-padding: 16;"/>
        <ListView fx:id="userList" prefWidth="260" prefHeight="560" style="-fx-background-color: transparent; -fx-border-color: transparent;"/>
    </VBox>
    <VBox prefWidth="872" prefHeight="700" style="-fx-background-color: white;">
        <HBox prefHeight="52" prefWidth="872" style="-fx-background-color: white; -fx-padding: 12; -fx-spacing: 10;">
            <Label text="Direct" style="-fx-text-fill: black; -fx-font-size: 20; -fx-font-weight: bold;"/>
            <Label fx:id="chatWithLabel" text="Selectionnez un contact" style="-fx-text-fill: black; -fx-font-size: 17; -fx-font-weight: bold;"/>
        </HBox>
        <ListView fx:id="messageList" prefWidth="872" prefHeight="530" style="-fx-background-color: white; -fx-border-color: transparent;"/>
        <VBox prefHeight="118" prefWidth="872" style="-fx-padding: 10; -fx-background-color: white;">
            <TextField fx:id="messageField" prefWidth="832" promptText="Ecrire un message..." style="-fx-font-size: 14; -fx-padding: 12;"/>
            <HBox prefHeight="40" style="-fx-spacing: 10; -fx-padding: 8;">
                <Label text="Entree pour envoyer" style="-fx-font-size: 11;"/>
                <Button text="Envoyer" onAction="#handleSend" style="-fx-background-color: purple; -fx-text-fill: white; -fx-font-size: 13; -fx-font-weight: bold; -fx-background-radius: 4; -fx-padding: 8; -fx-cursor: hand; -fx-border-width: 0;"/>
            </HBox>
        </VBox>
    </VBox>
</HBox>